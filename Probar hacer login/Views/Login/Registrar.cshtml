@model Probar_hacer_login.Models.UsuarioModels
@{
    ViewData["Title"] = "Crear tu cuenta";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Asegúrate de que tu _Layout.cshtml exista
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Probar_hacer_login</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            background: url('/images/cars-bmw-fari-avtomobil-pasmurno-oblaka-129018.jpeg') no-repeat;
            background-size: cover;
            background-position: center;
            padding-top: 1.5rem;
            padding-bottom: 1.5rem;
            min-height: 100vh;
            align-items: flex-start;
            padding-top: 1.5rem;
            padding-bottom: 1.5rem;


        }




        .form-input {
            width: 100%;
            padding-left: 1rem;
            padding-right: 1rem;
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.4);
            border-radius: 0.5rem;
            box-shadow: none;
            outline: none;
            background: transparent;
            color: white;
       
        }

            .form-input:focus {
                border-color: white;
                backdrop-filter: blur(15px);
                --tw-ring-color: #3b82f6;
                --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);
                --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);
                box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);
            }

        .transparent-box {
            background-color: rgba(0, 0, 0, 0.7); 
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            border-radius: 1rem; 
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
            padding: 2rem;
            min-width: 300px;

        }

        .text-gray-700 {
            color: white !important;
        }

        /* Hace el texto de la cabecera "Únete a nuestra consecionaria" blanco */
        .text-gray-800 {
            color: white !important;
        }

        /* Hace los íconos (envelope, lock) blancos */
        .input-group .icon {
            color: #ccc;
        }


        .btn-primary {
            width: 100%;
            padding-left: 1rem;
            padding-right: 1rem;
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            background-color: #2563eb;
            color: white;
            font-weight: 600;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

            .btn-primary:hover {
                background-color: #1d4ed8;
            }

            .btn-primary:focus {
                outline: 2px solid transparent;
                outline-offset: 2px;
                --tw-ring-color: #3b82f6;
                --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);
                --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);
                box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);
            }

        .btn-secondary {
            width: 100%;
            padding-left: 1rem;
            padding-right: 1rem;
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            background-color: #e5e7eb;
            color: #1f2937;
            font-weight: 600;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

            .btn-secondary:hover {
                background-color: #d1d5db;
            }

            .btn-secondary:focus {
                outline: 2px solid transparent;
                outline-offset: 2px;
                --tw-ring-color: #9ca3af;
                --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);
                --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);
                box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-shadow, 0 0 #0000);
            }

        .social-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding-left: 1rem;
            padding-right: 1rem;
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            font-weight: 600;
        }

            .social-btn.google {
                background-color: #2563eb;
                color: white;
            }

                .social-btn.google:hover {
                    background-color: #1d4ed8;
                }

            .social-btn.linkedin {
                background-color: #1e40af;
                color: white;
            }

                .social-btn.linkedin:hover {
                    background-color: #1e3a8a;
                }

        .input-group {
            position: relative;
            display: flex;
            align-items: center;
        }

            .input-group .icon {
                position: absolute;
                left: 0.75rem;
                color: #9ca3af;
            }

            .input-group input {
                padding-left: 2.5rem;
            }
    </style>
</head>
<body class="bg-gray-100">
    <div class="transparent-box w-full max-w-xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-gray-800 mb-6">Únete a nuestra consecionaria</h2>

        <div class="space-y-4 mb-6">
            <a href="@Url.Action("GoogleLogin", "Login")" class="social-btn google">
                <i class="fab fa-google mr-2"></i> Iniciar sesión con Google
            </a>
        </div>

        <form asp-controller="Login" asp-action="Registrar" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm font-medium mb-4"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="Nombre" class="block text-sm font-medium text-gray-700 mb-1">Nombre(s)<span class="text-red-500">*</span></label>
                    <input asp-for="Nombre" type="text" placeholder="Ingresá tu nombre" class="form-input" />
                    <span asp-validation-for="Nombre" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label for="Apellido" class="block text-sm font-medium text-gray-700 mb-1">Apellido(s)<span class="text-red-500">*</span></label>
                    <input asp-for="Apellido" type="text" placeholder="Ingresá tu apellido" class="form-input" />
                    <span asp-validation-for="Apellido" class="text-red-500 text-xs mt-1 block"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="Documento" class="block text-sm font-medium text-gray-700 mb-1">Documento<span class="text-red-500">*</span></label>
                    <input asp-for="Documento" type="text" placeholder="Número de documento" class="form-input" />
                    <span asp-validation-for="Documento" class="text-red-500 text-xs mt-1 block"></span>
                </div>
                <div>
                    <label for="Telefono" class="block text-sm font-medium text-gray-700 mb-1">Teléfono celular<span class="text-red-500">*</span></label>
                    <div class="flex space-x-2">
                        <select class="form-input w-1/3">
                            <option>+54</option>
                        </select>
                        <input type="text" placeholder="Número" class="form-input w-2/3" />
                    </div>
                </div>
            </div>

            <div>
                <label for="Email" class="block text-sm font-medium text-gray-700 mb-1">Email<span class="text-red-500">*</span></label>
                <div class="input-group">
                    <i class="icon fas fa-envelope"></i>
                    <input asp-for="Email" type="email" placeholder="Ingresá tu email" class="form-input" />
                </div>
                <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label for="Contraseña" class="block text-sm font-medium text-gray-700 mb-1">Contraseña<span class="text-red-500">*</span></label>
                <div class="input-group">
                    <i class="icon fas fa-lock"></i>
                    <input asp-for="Contraseña" type="password" placeholder="Ingresá tu contraseña" class="form-input" />
                    <button type="button" class="absolute right-3 text-gray-400" onclick="togglePasswordVisibility('Contraseña')">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Contraseña" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label for="ConfirmarContraseña" class="block text-sm font-medium text-gray-700 mb-1">Confirmar Contraseña<span class="text-red-500">*</span></label>
                <div class="input-group">
                    <i class="icon fas fa-lock"></i>
                    <input asp-for="ConfirmarContraseña" type="password" placeholder="Confirmá tu contraseña" class="form-input" />
                    <button type="button" class="absolute right-3 text-gray-400" onclick="togglePasswordVisibility('ConfirmarContraseña')">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmarContraseña" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <p class="text-sm text-gray-600">
                <span class="text-red-500">*</span> Campos obligatorios.
            </p>

            <div class="flex items-center space-x-2">
                <input type="checkbox" id="aceptoCondiciones" class="form-checkbox h-4 w-4 text-blue-600 rounded" required />
                <label for="aceptoCondiciones" class="text-sm text-gray-700">Acepto las <a href="#" class="text-blue-600 hover:underline">Condiciones de uso</a> y las <a href="#" class="text-blue-600 hover:underline">Políticas de privacidad</a> de Bumeran.</label>
            </div>

            <div class="flex items-center space-x-2">
                <input type="checkbox" id="aceptoPromociones" class="form-checkbox h-4 w-4 text-blue-600 rounded" />
                <label for="aceptoPromociones" class="text-sm text-gray-700">Acepto recibir Novedades y Promociones</label>
            </div>

            <button type="submit" class="btn-primary mt-6">Crear cuenta</button>
        </form>

        <p class="text-center text-gray-600 mt-4">
            ¿Ya tenés cuenta? <a href="@Url.Action("Login", "Login")" class="text-blue-600 hover:underline font-semibold">Ingresá como candidato</a>
        </p>
    </div>

    <script>
        function togglePasswordVisibility(id) {
            const input = document.getElementById(id);
            const icon = input.nextElementSibling.querySelector('i');
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>